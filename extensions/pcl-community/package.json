{
  "name": "pcl-community",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "pcln",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "pcl-n",
    "plugin",
    "pnp",
    "community"
  ],
  "activationEvents": [
    "workspaceContains:**/plugin.manifest.json",
    "onCommand:pcl.community.createProject",
    "onCommand:pcl.community.checkEnvironment",
    "onCommand:pcl.community.build",
    "onCommand:pcl.community.package",
    "onCommand:pcl.community.validate",
    "onCommand:pcl.community.developmentSign"
  ],
  "main": "./out/extension",
  "icon": "media/icon.png",
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%untrustedWorkspaces.description%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "pcl.community.createProject",
        "title": "%command.createProject%",
        "category": "PCL"
      },
      {
        "command": "pcl.community.checkEnvironment",
        "title": "%command.checkEnvironment%",
        "category": "PCL"
      },
      {
        "command": "pcl.community.build",
        "title": "%command.build%",
        "category": "PCL"
      },
      {
        "command": "pcl.community.package",
        "title": "%command.package%",
        "category": "PCL"
      },
      {
        "command": "pcl.community.validate",
        "title": "%command.validate%",
        "category": "PCL"
      },
      {
        "command": "pcl.community.developmentSign",
        "title": "%command.developmentSign%",
        "category": "PCL"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pcl.community.createProject"
        },
        {
          "command": "pcl.community.checkEnvironment"
        },
        {
          "command": "pcl.community.build",
          "when": "pcl.community.isPluginWorkspace"
        },
        {
          "command": "pcl.community.package",
          "when": "pcl.community.isPluginWorkspace"
        },
        {
          "command": "pcl.community.validate",
          "when": "pcl.community.isPluginWorkspace"
        },
        {
          "command": "pcl.community.developmentSign",
          "when": "pcl.community.isPluginWorkspace"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "plugin.manifest.json",
          "**/plugin.manifest.json"
        ],
        "url": "./schemas/plugin.manifest.schema.json"
      }
    ],
    "languages": [
      {
        "id": "json",
        "filenames": [
          "plugin.manifest.json"
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "pcl",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "build",
              "package",
              "validate",
              "sign"
            ],
            "description": "%task.task.description%"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "pcl-analyzer",
        "owner": "pcl",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*)\\((\\d+),(\\d+)\\):\\s+(error|warning|info)\\s+(PCL\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ],
    "configuration": {
      "title": "PCL Community",
      "properties": {
        "pcl.community.cliPath": {
          "type": "string",
          "default": "",
          "description": "%config.cliPath%"
        },
        "pcl.community.sdkVersion": {
          "type": "string",
          "default": "0.1.0",
          "description": "%config.sdkVersion%"
        },
        "pcl.community.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "description": "%config.dotnetPath%"
        }
      }
    }
  },
  "scripts": {
    "compile": "gulp compile-extension:pcl-community",
    "watch": "gulp watch-extension:pcl-community",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PCL-N-Edition/PCL-NE-Plugin-IDE.git"
  }
}
