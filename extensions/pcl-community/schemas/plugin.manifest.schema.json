{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pcln.top/schemas/plugin.manifest.schema.json",
  "title": "PCL-N Plugin Manifest",
  "description": "Community Edition public contract for plugin.manifest.json (ADR-003 baseline).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "sdkVersion",
    "entry"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0",
      "description": "Manifest schema version."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9\\-]+)+$",
      "description": "Stable reverse-DNS plugin identifier (e.g. com.example.hello-pcl)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Human-readable plugin name."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.-]+)?$",
      "description": "Semantic version of the plugin package."
    },
    "sdkVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.-]+)?$",
      "description": "Public PNPSDK version this plugin targets."
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "author": {
      "type": "string",
      "maxLength": 256
    },
    "license": {
      "type": "string",
      "maxLength": 64
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assembly",
        "type"
      ],
      "properties": {
        "assembly": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to the plugin assembly inside the package."
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Fully-qualified type name of the plugin entry point."
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ui",
          "filesystem.read",
          "filesystem.write",
          "network",
          "process"
        ]
      },
      "uniqueItems": true,
      "default": []
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultCulture": {
          "type": "string",
          "default": "en"
        },
        "cultures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
